# Server
PORT=4000

# Meta / Messenger Platform
PAGE_ACCESS_TOKEN=your_page_access_token_here
VERIFY_TOKEN=choose_a_random_verify_string
APP_SECRET=your_meta_app_secret_here

# Database (fill in once you pick Firestore or Postgres)
DATABASE_URL=

# Firebase Storage (for generated reports before sending to Messenger)
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
# Provide ONE of the following:
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
